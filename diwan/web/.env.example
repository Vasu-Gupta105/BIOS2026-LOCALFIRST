# Optional Vite build settings. Copy to .env.local before building.
# All VITE_* values are public in the browser bundle. Never put secrets here.
# Leave settings commented to use the application defaults.

# VITE_DEFAULT_ACCOUNT_ID=self
# VITE_CLOUD_ENDPOINT=https://office.example.com
# VITE_LAN_ENDPOINT=http://127.0.0.1:8080
# VITE_OFFLINE_ONLY=false
# VITE_DOCS_COLLAB=on
# VITE_UPDATE_LOG=off
# VITE_SUBSTRATE_SYNC=on
