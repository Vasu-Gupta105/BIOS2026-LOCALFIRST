FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY web/package.json web/package-lock.json web/.npmrc ./web/
WORKDIR /build/web
RUN npm ci --no-audit --no-fund
WORKDIR /build
COPY . .
WORKDIR /build/web
RUN npm run build:cloud

FROM golang:1.27.3-bookworm AS server
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /build/dist ./dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X main.Version=railway" -o /out/localfirst .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates su-exec \
    && adduser -D -u 10001 localfirst \
    && mkdir -p /var/lib/localfirst
COPY --from=server /out/localfirst /usr/local/bin/localfirst
COPY scripts/railway-entrypoint.sh /usr/local/bin/localfirst-entrypoint
RUN chmod 755 /usr/local/bin/localfirst-entrypoint
WORKDIR /var/lib/localfirst
ENV GIN_MODE=release
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/localfirst-entrypoint"]
